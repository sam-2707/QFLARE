      {
        "id": 5,
        "title": "Load Average",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 1},
        "targets": [
          {
            "expr": "qflare_load_average{period=\"1m\", instance=~\"$instance\"}",
            "legendFormat": "1m Load"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 2},
                {"color": "red", "value": 4}
              ]
            },
            "unit": "short",
            "min": 0
